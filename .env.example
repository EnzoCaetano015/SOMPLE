APP_ENV=development
APP_NAME=SOMPLE API
API_HOST=0.0.0.0
API_PORT=8000

# PostgreSQL (Docker Compose local)
POSTGRES_DB=somple
POSTGRES_USER=somple_app
POSTGRES_PASSWORD=change_me_local

# SQLAlchemy + psycopg
DATABASE_URL=postgresql+psycopg://somple_app:change_me_local@db:5432/somple

# Authentication
JWT_SECRET_KEY=replace_with_a_long_random_secret
JWT_ALGORITHM=HS256
JWT_EXP_HOURS=24

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# Frontend build-time config
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Telemetry simulator
SOMPLE_API_URL=http://localhost:8000/api/v1
SOMPLE_DEMO_EMAIL=operador@somple.com
SOMPLE_DEMO_PASSWORD=Somple@123

# Dedicated regression database (docker-compose.test.yml)
TEST_DATABASE_URL=postgresql://somple_test:somple_test@localhost:5433/somple_test
